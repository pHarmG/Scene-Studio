{
  "ha_url": "http://homeassistant.local:8123",
  "ha_ssh_host": "homeassistant",
  "appdaemon_config_root": "/addon_configs/REPLACE_ME_addon_slug",
  "store_root": "/config/scene_studio_store",
  "runtime_mode": "registry_admin",
