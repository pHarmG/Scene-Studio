    "wled": {
      "enabled": false,
      "hosts": []
    },
    "ha_light": {
      "enabled": true,
      "ignored_entity_ids": []
    }
  },
  "integrations": {
    "hyperhdr": {
      "enabled": false,
      "host": null,
      "default_policy": "yield",
      "probe_ttl_seconds": 5
    }
  }
}
